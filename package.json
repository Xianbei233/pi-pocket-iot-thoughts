{
    "name": "pi-pocket-iot-thoughts",
    "version": "0.2.0",
    "description": "A Pi Pocket tool for visible-note nodes, with an owner-only settings page and its own hot-applied, persisted limits. Extraction is deterministic and offline.",
    "license": "MIT",
    "type": "module",
    "private": false,
    "engines": {
        "node": ">=22.19"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-durable": "1.3.0"
    },
    "files": [
        "iot-thoughts.ts",
        "iot-thoughts/",
        "manifest.json",
        "config.example.json",
        "README.md",
        "LICENSE",
        "PROVENANCE.md",
        "docs/design.md",
        "docs/install.md"
    ],
    "scripts": {
        "link:pocket": "node scripts/link-pocket.mjs",
        "check": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "test": "node --test test/*.test.ts",
        "pack:offline": "node scripts/pack.mjs"
    }
}
